# Captures from your own runs — these can carry call identifiers and account
# ids when taken through a telephony stack. The checked-in control under
# samples/ is engine-only and carries none, so it is allowed back in.
*.raw.jsonl
*.log.txt
!samples/*.raw.jsonl

# SIP credentials for the injector. Never commit this.
.env.injector
.env

jambonz-app/captures/
jambonz-app/node_modules/
node_modules/

__pycache__/
*.pyc
*.pcap
