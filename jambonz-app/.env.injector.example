# Copy to .env.injector and fill in. inject-call.sh sources it automatically,
# so a fresh terminal needs no exports.
#
#   cp .env.injector.example .env.injector
#   chmod 600 .env.injector        # it holds a password
#
# Anything already exported in the shell takes precedence over this file.
# .env.injector is gitignored — keep it that way.

# Your jambonz account's SIP realm, from Account in the portal. This is an auth
# domain, not necessarily a resolvable hostname.
SIP_REALM=your-account.sip.example.com

# Where the SIP packets actually go. On some clusters the per-account realm does
# not resolve and only the cluster SBC hostname does, which is why this is
# separate from SIP_REALM. Defaults to SIP_REALM if unset.
SBC_HOST=sip.example.com

# A Client created under your account, and its password.
SIP_USER=
SIP_PASS=

# Digits to dial. With "Application for SIP device calls" set on the account,
# any value routes to that application.
DEST=1000

# Audio to inject, relative to this directory.
AUDIO=../samples/sample-es-reservation.wav

# pcmu or pcma
CODEC=pcmu

# Extra hold time after playback, so trailing finals arrive before the BYE.
# Drop this to a few hundred ms if you want to test what happens when a call
# ends mid-turn.
TAIL_MS=6000
